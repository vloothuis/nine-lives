+// nl-engine patch: save file content and trees for a spliced snapshot.
+impl<S: IndexedTree> Repository<S> {
+    /// Returns a [`Saver`] that packs file content and trees, sharing one indexer.
+    ///
+    /// # Errors
+    ///
+    /// * If the packers could not be created.
+    pub fn saver(&self) -> RusticResult<Saver<'_, impl ReadGlobalIndex + '_>> {
+        use crate::archiver::file_archiver::FileArchiver;
+        use crate::blob::packer::{PackSizer, Packer};
+        use crate::index::indexer::Indexer;
+        let index = self.index();
+        let indexer = Indexer::new(self.dbe().clone()).into_shared();
+        let files = FileArchiver::new(self.dbe().clone(), index, indexer.clone(), self.config())?;
+        let pack_sizer =
+            PackSizer::from_config(self.config(), BlobType::Tree, index.total_size(BlobType::Tree));
+        let trees = Packer::new(self.dbe().clone(), BlobType::Tree, indexer.clone(), pack_sizer)?;
+        Ok(Saver {
+            index,
+            files,
+            trees,
+            indexer,
+            seen: std::sync::Mutex::new(std::collections::BTreeSet::new()),
+        })
+    }
+
+    /// Saves a snapshot file and returns its ID. Call this only after [`Saver::finalize`].
+    ///
+    /// # Errors
+    ///
+    /// * If the snapshot could not be written.
+    pub fn save_snapshot(&self, mut snap: SnapshotFile) -> RusticResult<SnapshotId> {
+        snap.id = SnapshotId::default();
+        Ok(self.dbe().save_file(&snap)?.into())
+    }
+}
+
+/// Packs file content and trees for a snapshot that is built outside the archiver.
+#[allow(missing_debug_implementations)]
+pub struct Saver<'a, I: ReadGlobalIndex> {
+    index: &'a I,
+    files: crate::archiver::file_archiver::FileArchiver<'a, DecryptBackend<Key>, I>,
+    trees: crate::blob::packer::Packer<DecryptBackend<Key>>,
+    indexer: crate::index::indexer::SharedIndexer<DecryptBackend<Key>>,
+    seen: std::sync::Mutex<std::collections::BTreeSet<TreeId>>,
+}
+
+impl<I: ReadGlobalIndex> Saver<'_, I> {
+    /// Chunks and packs the content read from `reader`, and returns `node` with that content and the
+    /// number of bytes read. This is what the archiver does for a new or changed file.
+    ///
+    /// # Errors
+    ///
+    /// * If reading or packing fails.
+    pub fn save_file(
+        &self,
+        reader: impl std::io::Read + Send + 'static,
+        node: Node,
+        p: &Progress,
+    ) -> RusticResult<(Node, u64)> {
+        self.files.backup_reader(reader, node, p)
+    }
+
+    /// Packs a tree unless the repository or this saver already has it, and returns its ID.
+    ///
+    /// # Errors
+    ///
+    /// * If the tree could not be serialized or packed.
+    pub fn save_tree(&self, tree: &Tree) -> RusticResult<TreeId> {
+        let (chunk, id) = tree.serialize().map_err(|err| {
+            RusticError::with_source(ErrorKind::Internal, "Failed to serialize tree.", err)
+        })?;
+        if !self.index.has_tree(&id) && self.seen.lock().unwrap().insert(id) {
+            self.trees.add(chunk.into(), BlobId::from(*id))?;
+        }
+        Ok(id)
+    }
+
+    /// Writes the last packs and the index, and adds the packer statistics to `summary`.
+    ///
+    /// # Errors
+    ///
+    /// * If a pack or the index could not be written.
+    pub fn finalize(self, summary: &mut SnapshotSummary) -> RusticResult<()> {
+        self.files.finalize()?.apply(summary, BlobType::Data);
+        self.trees.finalize()?.apply(summary, BlobType::Tree);
+        self.indexer.write().unwrap().finalize()?;
+        Ok(())
+    }
+}
+
+// nl-engine patch: encode and decode unpacked repository files, for restic lock files.
+impl<S: Open> Repository<S> {
+    /// Compresses (for repository version 2) and encrypts a repository file, as restic's
+    /// `SaveUnpacked` does. The file name is the SHA-256 of the result.
+    ///
+    /// # Errors
+    ///
+    /// * If compression or encryption fails.
+    pub fn encode_unpacked(&self, data: &[u8]) -> RusticResult<Vec<u8>> {
+        self.dbe().encrypt_file(data)
+    }
+
+    /// Decrypts and, if needed, decompresses a repository file.
+    ///
+    /// # Errors
+    ///
+    /// * If the file cannot be decrypted or decompressed.
+    pub fn decode_unpacked(&self, data: &[u8]) -> RusticResult<Vec<u8>> {
+        self.dbe().decrypt_file(data)
+    }
+}
