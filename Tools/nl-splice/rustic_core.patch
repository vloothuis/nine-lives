+
+// nl-splice patch: write tree blobs and snapshots directly.
+impl<S: IndexedTree> Repository<S> {
+    /// Save the given trees as tree blobs, then write the index.
+    ///
+    /// Trees already in the index are not written again. Packs and the index are finalized before
+    /// this returns, so a snapshot saved afterwards never points at unindexed trees.
+    ///
+    /// # Errors
+    ///
+    /// * If a tree cannot be serialized or a pack or index file cannot be written.
+    pub fn save_trees(&self, trees: Vec<Tree>) -> RusticResult<Vec<TreeId>> {
+        use crate::blob::packer::{PackSizer, Packer};
+        use crate::index::{ReadIndex, indexer::Indexer};
+
+        let index = self.index();
+        let indexer = Indexer::new(self.dbe().clone()).into_shared();
+        let pack_sizer =
+            PackSizer::from_config(self.config(), BlobType::Tree, index.total_size(BlobType::Tree));
+        let packer = Packer::new(self.dbe().clone(), BlobType::Tree, indexer.clone(), pack_sizer)?;
+        let mut seen = std::collections::BTreeSet::new();
+        let mut ids = Vec::with_capacity(trees.len());
+        for tree in trees {
+            let (chunk, id) = tree.serialize().map_err(|err| {
+                RusticError::with_source(ErrorKind::Internal, "Failed to serialize tree.", err)
+            })?;
+            if !index.has_tree(&id) && seen.insert(id) {
+                packer.add(chunk.into(), BlobId::from(*id))?;
+            }
+            ids.push(id);
+        }
+        _ = packer.finalize()?;
+        indexer.write().unwrap().finalize()?;
+        Ok(ids)
+    }
+
+    /// Save one snapshot and return its ID.
+    ///
+    /// # Errors
+    ///
+    /// * If the snapshot cannot be serialized or written.
+    pub fn save_snapshot(&self, mut snap: SnapshotFile) -> RusticResult<SnapshotId> {
+        snap.id = SnapshotId::default();
+        Ok(self.dbe().save_file(&snap)?.into())
+    }
+}
